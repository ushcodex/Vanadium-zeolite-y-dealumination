NAME = /home/azureuser/03_tier2_completion/jobs/scope3/pbe0_v-p.inp
|  1> # SCOPE 3  |  final-level single point on a RELAXED geometry
|  2> # State: v-p  |  register row: v-p-PBE0<T2>
|  3> # Why: second functional on the SAME relaxed geometry, so the B3LYP and PBE0
|  4> #      columns of the level table differ only by the functional, not by the
|  5> #      geometry. This is the cross-check that the old 24-slot single-point set
|  6> #      could not provide (it used unrelaxed TIER 1 shapes).
|  7> # Gate: TERMINATED NORMALLY and an SCF energy; no frequency is needed here.
|  8> 
|  9> ! PBE0 D3BJ def2-TZVP RIJCOSX def2/J TightSCF DefGrid3
| 10> 
| 11> %pal nprocs 4 end
| 12> %maxcore 3000
| 13> 
| 14> %scf
| 15>   MaxIter 300
| 16> end
| 17> 
| 18> * xyzfile 0 1 results/geom/v-p.xyz
| 19> 
| 20>                          ****END OF INPUT****
